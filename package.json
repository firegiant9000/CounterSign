{
  "name": "countersign",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt -b firefox --mv3",
    "build": "wxt build -b firefox --mv3",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "typecheck": "tsc -p core/tsconfig.json --noEmit && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:build": "vitest run --project build",
    "lint:ext": "web-ext lint --source-dir .output/firefox-mv3",
    "gate": "npm run lint && npm run typecheck && npm run test && npm run build && npm run test:build && npm run lint:ext"
  },
  "dependencies": {
    "idb": "8.0.4",
    "preact": "11.2.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "fake-indexeddb": "6.2.8",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "web-ext": "10.8.0",
    "wxt": "0.21.5"
  }
}
