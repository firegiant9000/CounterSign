# Signing credentials for `web-ext sign`. Keep real values out of this file.
# Set them in the shell session that runs `web-ext sign`, or in an ignored
# .env.local that the owner loads by hand. Nothing in the project reads these.
WEB_EXT_API_KEY=
WEB_EXT_API_SECRET=

# Dev only, for `npm run shots`: path to a release Firefox 147 or newer, for
# example C:\Program Files\Mozilla Firefox\firefox.exe. On first run Selenium
# Manager downloads geckodriver from GitHub into ~/.cache/selenium. The script
# turns off Selenium Manager's usage stats (SE_AVOID_STATS).
SHOTS_FIREFOX=
